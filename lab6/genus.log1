@file(script.tcl) 11: if {$DESIGN_NAME == "bit_rca"} {
    # Virtual clock for purely combinational RCA design
    create_clock -name vclk -period 10.0
    set clk_port "vclk"
} else {
    
    create_clock -name clk -period 10.0 [get_ports clk]
    set clk_port "clk"
}
@file(script.tcl) 22: set_input_delay 1.0 -clock $clk_port [all_inputs]
@file(script.tcl) 23: set_output_delay 1.0 -clock $clk_port [all_outputs]
@file(script.tcl) 24: set_input_transition 0.5 [all_inputs]
@file(script.tcl) 25: set_load 0.05 [all_outputs]
@file(script.tcl) 30: syn_generic

