# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line
create_library_set -name slow -timing {../../../../install/FOUNDRY/digital/90nm/dig/lib/slow.lib}
create_library_set -name fast -timing {../../../../install/FOUNDRY/digital/90nm/dig/lib/fast.lib}
create_constraint_mode -name c -sdc_files {exp_constraints.sdc}
create_delay_corner -name maxdelay -library_set {slow}
create_delay_corner -name mindelay -library_set {fast}
create_analysis_view -name worst -constraint_mode {c} -delay_corner {maxdelay}
create_analysis_view -name best -constraint_mode {c} -delay_corner {mindelay}
set_analysis_view -setup {worst} -hold {best}
