# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line
create_rc_corner -name default_rc_corner -preRoute_res {1} -preRoute_cap {1} -preRoute_clkres {0} -preRoute_clkcap {0} -postRoute_res {{1 1 1}} -postRoute_cap {{1 1 1}} -postRoute_xcap {{1 1 1}} -postRoute_clkres {{0 0 0}} -postRoute_clkcap {{0 0 0}}
create_library_set -name fast -timing {../../../../install/FOUNDRY/digital/90nm/dig/lib/fast.lib}
create_library_set -name slow -timing {../../../../install/FOUNDRY/digital/90nm/dig/lib/slow.lib}
create_constraint_mode -name comb -sdc_files {exp_constraints_comb.sdc}
create_delay_corner -name min_Delay -library_set {fast} -rc_corner {default_rc_corner}
create_delay_corner -name max_delay -library_set {slow} -rc_corner {default_rc_corner}
create_analysis_view -name worst -constraint_mode {comb} -delay_corner {max_delay}
create_analysis_view -name best -constraint_mode {comb} -delay_corner {min_Delay}
set_analysis_view -setup {worst} -hold {best}
