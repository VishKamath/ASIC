# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line
create_library_set -name fast -timing {../../../../install/FOUNDRY/digital/90nm/dig/lib/fast.lib ../../../../install/FOUNDRY/digital/90nm/dig/lib/slow.lib}
create_library_set -name slow -timing {../../../../install/FOUNDRY/digital/90nm/dig/lib/slow.lib}
create_constraint_mode -name comb -sdc_files {exp_constraints_comb.sdc}
create_delay_corner -name min_Delay -library_set {fast}
create_delay_corner -name max_delay -library_set {slow}
create_analysis_view -name best -constraint_mode {comb} -delay_corner {min_Delay}
create_analysis_view -name worst -constraint_mode {comb} -delay_corner {max_delay}
set_analysis_view -setup {worst} -hold {best}
