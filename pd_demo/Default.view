# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line
create_library_set -name MIN_DELAY -timing {../../../install/FOUNDRY/digital/90nm/dig/lib/fast.lib}
create_library_set -name MAX_DELAY -timing {../../../install/FOUNDRY/digital/90nm/dig/lib/slow.lib}
create_constraint_mode -name Constraints -sdc_files {fir/fir_4tap.sdc}
create_delay_corner -name MINDELAY -library_set {MIN_DELAY}
create_delay_corner -name MAXDELAY -library_set {MAX_DELAY}
create_analysis_view -name BEST_CASE -constraint_mode {Constraints} -delay_corner {MINDELAY}
create_analysis_view -name WORST_CASE -constraint_mode {Constraints} -delay_corner {MAXDELAY}
set_analysis_view -setup {BEST_CASE} -hold {WORST_CASE}
