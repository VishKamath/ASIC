# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line
create_rc_corner -name default_rc_corner -preRoute_res {1} -preRoute_cap {1} -preRoute_clkres {0} -preRoute_clkcap {0} -postRoute_res {1} -postRoute_cap {1} -postRoute_xcap {1}
create_library_set -name max_timing -timing {/home/vlsi14/24BVD1042/pd_demo/fir/fir_4tap.enc.dat/libs/mmmc/slow.lib}
create_library_set -name min_timing -timing {/home/vlsi14/24BVD1042/pd_demo/fir/fir_4tap.enc.dat/libs/mmmc/fast.lib}
create_constraint_mode -name constraints -sdc_files {fir_4tap.sdc}
create_delay_corner -name max_delay -library_set {max_timing}
create_delay_corner -name min_delay -library_set {min_timing}
create_analysis_view -name best_case -constraint_mode {constraints} -delay_corner {min_delay}
create_analysis_view -name worst_case -constraint_mode {constraints} -delay_corner {max_delay}
set_analysis_view -setup {worst_case best_case} -hold {worst_case best_case}
