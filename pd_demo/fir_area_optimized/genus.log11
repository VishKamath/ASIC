#@ Processing -files option
@genus 1> source fir_4taps.tcl
#@ Begin verbose source ./fir_4taps.tcl
@file(fir_4taps.tcl) 1: set TOP_MODULE "fir_4tap_shared"
@file(fir_4taps.tcl) 2: set HDL_FILE   "fir_4tap_shared_mult.v"
@file(fir_4taps.tcl) 3: set SDC_FILE   "fir_4tap_shared_mult.sdc"
@file(fir_4taps.tcl) 5: set tech_nodes [list 180nm 90nm 45nm]
@file(fir_4taps.tcl) 6: set corners    [list slow typical fast]
@file(fir_4taps.tcl) 9: file mkdir output/netlist
@file(fir_4taps.tcl) 10: file mkdir output/constraints
@file(fir_4taps.tcl) 11: file mkdir output/reports
@file(fir_4taps.tcl) 13: foreach tech $tech_nodes {
    foreach corner $corners {
 
 
        # Set library search path
        set_db init_lib_search_path [list "/home/install/FOUNDRY/digital/${tech}/dig/lib"]
 
        # Explicitly evaluate read_libs with the resolved string to prevent TUI-202
        set lib_file "${corner}.lib"
        eval read_libs $lib_file
 
        # Read RTL & Elaborate
        read_hdl [list $HDL_FILE]
        elaborate $TOP_MODULE
        init_design
 
        # Apply constraints
        read_sdc $SDC_FILE
 
        # Synthesis effort
        set_db syn_generic_effort medium
        set_db syn_map_effort medium
        set_db syn_opt_effort medium
 
        # Run Synthesis
        syn_generic
        syn_map
        syn_opt
 
        # Identifier tag
        set run_tag "${TOP_MODULE}_${tech}_${corner}"
 
        # Write Gate-Level Netlist & SDC
        write_hdl > "output/netlist/${run_tag}_opt.v"
        write_sdc > "output/constraints/${run_tag}_synth.sdc"
 
        # Export Reports
        report_timing > "output/reports/${run_tag}_timing.rpt"
        report_power  > "output/reports/${run_tag}_power.rpt"
        report_area   > "output/reports/${run_tag}_area.rpt"
        report_gates  > "output/reports/${run_tag}_gates.rpt"
        report_qor    > "output/reports/${run_tag}_qor.rpt"
 
        puts "=============================================="
        puts ">>> FINISHED: ${run_tag}"
        puts "=============================================="
    }
}
